# Copy to .env and adjust. Never commit real secrets.

# PostgreSQL
POSTGRES_USER=subnexa
POSTGRES_PASSWORD=subnexa
POSTGRES_DB=subnexa
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://subnexa:subnexa@localhost:5432/subnexa

# FastAPI
APP_ENV=development
APP_NAME=Brightloop
APP_DESCRIPTION=Subscription Management and Recurring Billing System.
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=30

# Seeded demo accounts (created or repaired by the seed command)
DEMO_PASSWORD=DemoPass123!
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# SMTP (optional in Phase 1 — reset links are logged in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
ENABLE_BILLING_SCHEDULER=true
BILLING_INTERVAL_HOURS=1
FRONTEND_URL=http://localhost:5173

# Frontend (also copy VITE_API_URL into frontend/.env)
VITE_API_URL=http://localhost:8000/api/v1
